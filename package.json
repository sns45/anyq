{
  "name": "anyq-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/testers/*"
  ],
  "scripts": {
    "build": "bun run --filter '@anyq/core' build && bun run --filter '@anyq/*' --filter '!@anyq/core' build",
    "test": "bun run --filter '@anyq/core' --filter '@anyq/memory' test",
    "lint": "echo 'Linter not yet configured'",
    "clean": "bun run --filter '@anyq/*' clean",
    "dev": "bun run --filter '@anyq/*' dev",
    "typecheck": "bun run --filter '@anyq/*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
